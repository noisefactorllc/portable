{
  "name": "portable-viewer-test",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx serve . -l 2999",
    "package": "node package-portable.mjs",
    "test": "npm run test:docs && npm run test:runtime",
    "test:docs": "node test-docs.mjs",
    "test:runtime": "node --test --test-concurrency=1 --test-reporter=./scripts/strict-reporter.mjs test-workspace.mjs test-mcp-config.mjs test-runtime.mjs"
  },
  "dependencies": {
