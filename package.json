    "openai": "^7.62.0"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "playwright": "^1.65.0",
    "serve": "^14.2.7"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
